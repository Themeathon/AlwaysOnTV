		"ffprobe-static": "^3.1.0",
		"fluent-ffmpeg": "^2.1.3",
		"got": "^15.0.5",
		"grant": "^5.4.24",
		"grant-koa": "^5.4.8",
		"joi": "^18.2.2",
		"knex": "^3.2.10",
